{
  "name": "Auto SMS for ERPNext (try it)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm ci",
  "postAttachCommand": "node scripts/setup-env.mjs && npm run dev",
  "customizations": {
    "codespaces": {
      "openFiles": ["TESTING.md"]
    }
  }
}
