# Copy this file to .env and fill it in.

# Password for the dashboard (at least 8 characters). Required.
ADMIN_PASSWORD=change-this-password

# Port of the dashboard on your server (Docker). install.sh picks a free one if 3000 is taken.
PUBLIC_PORT=3000
# 0.0.0.0 = reachable from other devices; 127.0.0.1 = only through an HTTPS proxy on the same server.
BIND_ADDRESS=0.0.0.0

# ERPNext connection. Optional here: you can also enter it in the dashboard
# (Settings → ERPNext connection). Values set here can't be changed in the dashboard.
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Optional: secret for instant sending through an ERPNext Webhook (see README).
WEBHOOK_SECRET=

# Optional: time zone of the server, e.g. Asia/Dubai. Report schedules use the
# time zone from Settings, or ERPNext's time zone when that is empty.
# TZ=Asia/Dubai

# Sites allowed to control this server from the browser (the app on GitHub Pages).
# Default: https://aliiherzi.github.io  – add more separated by commas.
# ALLOWED_ORIGINS=https://aliiherzi.github.io

# Optional
# LOG_LEVEL=info              # debug for more detail
# TRUST_PROXY=true            # set when the dashboard runs behind nginx/Traefik with HTTPS
# WHATSAPP_PROXY=             # http(s) proxy for the WhatsApp connection, if your network needs one
# DATA_DIR=./data             # where settings, the database and WhatsApp sessions are stored (without Docker)
# PORT=3000                   # dashboard port when running without Docker (npm start)
